# Copy this file to .env and fill in your values
# cp .env.example .env

OPIK_API_KEY=your-opik-api-key
OPIK_WORKSPACE=your-workspace-name
OPIK_PROJECT_NAME=elastic-poc
DATASET_NAME=elastic-agent-qa-v1

OPENROUTER_API_KEY=<your-open-router-api-key>
#OPENROUTER_API_BASE=https://your-enterprise-endpoint.com # only if not using openrouter.ai

# GCS Dataset source
GCS_BUCKET=gcs-bucket
GCS_OBJECT=gcs-object

# Kibana Agent Builder
KIBANA_URL=https://your-kibana.example.com
KIBANA_API_KEY=your-kibana-api-key
